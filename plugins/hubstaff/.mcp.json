{
  "mcpServers": {
    "hubstaff": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/server.mjs"],
      "env": {
        "HUBSTAFF_PAT": "${user_config.hubstaff_token}",
        "HUBSTAFF_CLI_PATH": "${user_config.hubstaff_cli_path}",
        "HUBSTAFF_STATE_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
